            "contentURL": "https://raw.githubusercontent.com/tristan-huber/util.FuseWire/master/project.abundance?sanitize=true",
            "svgURL": "https://raw.githubusercontent.com/tristan-huber/util.FuseWire/master/project.svg?sanitize=true",
            "isLocal": false
          },
